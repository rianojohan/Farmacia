# Configuración pública de Supabase (valores de tu propio proyecto).
# Crea un proyecto en https://supabase.com, ejecuta supabase/schema.sql en el
# editor SQL y copia aquí la URL y la clave anon (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
